# 复制为 .env 后填写（.env 不入 Git）。随机串可用：openssl rand -base64 32

# http-only：备案前用 IP 访问；https：备案 + 证书就绪后
NGINX_CONF=http-only

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# 至少 32 字节
JWT_SECRET=
ID_CARD_AES_KEY=
ID_CARD_PEPPER=

OPS_BOOTSTRAP_USERNAME=opsadmin
OPS_BOOTSTRAP_PASSWORD=

AGENT_LLM_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
AGENT_OCR_MODE=TEXT_LLM

# 首次部署自动建表；稳定后可改 never
SPRING_SQL_INIT_MODE=always
