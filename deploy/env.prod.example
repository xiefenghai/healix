# 复制到 ECS：/opt/healix/app/healix.env 后改真实值（勿提交 Git）
# systemd 通过 EnvironmentFile= 加载

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MySQL（RDS）
SPRING_DATASOURCE_URL=jdbc:mysql://rm-xxxx.mysql.rds.aliyuncs.com:3306/healix?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=true
SPRING_DATASOURCE_USERNAME=healix
SPRING_DATASOURCE_PASSWORD=change-me

# 首期可 always 自动补表；稳定后改为 never
SPRING_SQL_INIT_MODE=always

# Redis
REDIS_HOST=r-xxxx.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_PASSWORD=

# 安全（必须更换）
JWT_SECRET=replace-with-random-32bytes-min!!!!!!
ID_CARD_AES_KEY=replace-with-random-aes-key!!!!
ID_CARD_PEPPER=replace-with-random-pepper
OPS_BOOTSTRAP_USERNAME=opsadmin
OPS_BOOTSTRAP_PASSWORD=ChangeMeStrongPass!

# 智能体 / DeepSeek
AGENT_LLM_ENABLED=true
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
VISION_MODEL=deepseek-v4-flash-vision-exp
AGENT_OCR_MODE=VISION

# 可选
INFLUX_ENABLED=false
ZIPKIN_ENDPOINT=
