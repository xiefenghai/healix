# DeepSeek API（对话 / 结构化，复制为 .env 或 export 后启动）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
AGENT_LLM_ENABLED=true

# 检验单 OCR 识图（默认复用 DeepSeek Key；多模态模型）
VISION_MODEL=deepseek-v4-flash-vision-exp
# 可选覆盖（不填则与 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL 相同）
# VISION_API_KEY=
# VISION_BASE_URL=

# OCR 模式：VISION=图直接结构化（验证推荐） | TEXT_LLM=识图提字+对话模型结构化
AGENT_OCR_MODE=VISION
