    },
    {
      "code": "WL.ENERGY_DEFICIT", "rev": 1, "sourceCode": "CN_MNT", "section": "能量缺口",
      "kind": "SAFETY", "block": "DIET",
      "appliesWhen": {}, "contraindicatedWhen": { "pregnantOrLactating": true },
      "staffText": "每日能量缺口一般控制在约 500–750 kcal，孕哺期不做热量缺口",
