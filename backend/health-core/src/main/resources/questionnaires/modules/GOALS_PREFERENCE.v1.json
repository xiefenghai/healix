{
  "code": "GOALS_PREFERENCE",
  "version": 1,
  "title": "诉求与目标",
  "script": "这次您最希望达到什么效果？用您自己的话说就好，我们按您的目标来一起定节奏。",
  "items": [
    {
      "field": "goal.primaryAppeal",
      "label": "这次最想解决什么问题？",
      "level": "REQUIRED"
    },
    {
      "field": "goal.appealText",
      "label": "客户原话",
      "level": "FIRST_VISIT"
    },
    {
      "field": "goal.doctorAdvised",
      "label": "是医生建议减重的吗？",
      "level": "LATER"
    },
    {
      "field": "goal.mode",
      "label": "目标类型",
      "level": "FIRST_VISIT"
    },
    {
      "field": "goal.targetWeightKg",
      "label": "希望减到多少？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.mode",
        "eq": "LOSS"
      },
      "highlights": [
        {
          "when": {
            "computed": "目标BMI",
            "op": "<",
            "value": 18.5
          },
          "severity": "CAUTION",
          "planEffect": "按当前身高计算，目标体重对应 BMI < 18.5，请先补身高或上调目标体重"
        }
      ]
    },
    {
      "field": "goal.targetDate",
      "label": "希望多久达到体重目标？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.mode",
        "eq": "LOSS"
      }
    },
    {
      "field": "goal.targetWaistCm",
      "label": "腰围目标",
      "level": "LATER"
    },
    {
      "field": "goal.targetBodyFat",
      "label": "体脂率目标",
      "level": "LATER",
      "showIf": {
        "field": "goal.mode",
        "eq": "BODY_COMPOSITION"
      }
    },
    {
      "field": "goal.exerciseMinutesPerDay",
      "label": "每天能拿出多少时间运动？",
      "level": "LATER"
    },
    {
      "field": "goal.dietEffort",
      "label": "饮食上能做多大调整？",
      "level": "LATER"
    },
    {
      "field": "goal.followupChannel",
      "label": "希望怎么跟进？",
      "level": "LATER"
    },
    {
      "field": "goal.followupFrequency",
      "label": "希望多久沟通一次？",
      "level": "LATER"
    },
    {
      "field": "goal.constraints",
      "label": "经济或时间上有什么限制？",
      "level": "LATER"
    }
  ]
}
