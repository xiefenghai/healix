{
  "code": "GOALS_PREFERENCE",
  "version": 2,
  "title": "诉求与目标",
  "script": "先聊聊这次最想解决什么、打算纳入哪条管理线。定好方向后，后面只展开相关问题，少打扰您。",
  "items": [
    {
      "field": "goal.primaryAppeal",
      "label": "这次最想解决什么问题？",
      "level": "REQUIRED"
    },
    {
      "field": "goal.careTracks",
      "label": "本次纳入哪些管理方向？",
      "level": "REQUIRED"
    },
    {
      "field": "goal.appealText",
      "label": "客户原话",
      "level": "FIRST_VISIT"
    },
    {
      "field": "goal.doctorAdvised",
      "label": "是医生建议做这次管理的吗？",
      "level": "LATER"
    },
    {
      "field": "goal.mode",
      "label": "目标类型",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["WEIGHT_LOSS", "DIABETES", "HYPERTENSION"]
      }
    },
    {
      "field": "goal.targetWeightKg",
      "label": "希望减到多少？",
      "level": "FIRST_VISIT",
      "showIf": {
        "all": [
          {
            "field": "goal.careTracks",
            "intersects": ["WEIGHT_LOSS"]
          },
          {
            "field": "goal.mode",
            "eq": "LOSS"
          }
        ]
      },
      "highlights": [
        {
          "when": {
            "computed": "目标BMI",
            "op": "<",
            "value": 18.5
          },
          "severity": "CAUTION",
          "planEffect": "按当前身高计算，目标体重对应 BMI < 18.5，请先补身高或上调目标体重"
        }
      ]
    },
    {
      "field": "goal.targetDate",
      "label": "希望多久达到体重目标？",
      "level": "FIRST_VISIT",
      "showIf": {
        "all": [
          {
            "field": "goal.careTracks",
            "intersects": ["WEIGHT_LOSS"]
          },
          {
            "field": "goal.mode",
            "eq": "LOSS"
          }
        ]
      }
    },
    {
      "field": "goal.targetWaistCm",
      "label": "腰围目标",
      "level": "LATER",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["WEIGHT_LOSS"]
      }
    },
    {
      "field": "goal.targetBodyFat",
      "label": "体脂率目标",
      "level": "LATER",
      "showIf": {
        "all": [
          {
            "field": "goal.careTracks",
            "intersects": ["WEIGHT_LOSS"]
          },
          {
            "field": "goal.mode",
            "eq": "BODY_COMPOSITION"
          }
        ]
      }
    },
    {
      "field": "goal.targetHba1c",
      "label": "糖化血红蛋白目标",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["DIABETES"]
      }
    },
    {
      "field": "goal.targetFpg",
      "label": "空腹血糖目标",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["DIABETES"]
      }
    },
    {
      "field": "goal.targetBpSys",
      "label": "收缩压目标",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["HYPERTENSION"]
      }
    },
    {
      "field": "goal.targetBpDia",
      "label": "舒张压目标",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["HYPERTENSION"]
      }
    },
    {
      "field": "goal.exerciseMinutesPerDay",
      "label": "每天能拿出多少时间运动？",
      "level": "LATER"
    },
    {
      "field": "goal.dietEffort",
      "label": "饮食上能做多大调整？",
      "level": "LATER"
    },
    {
      "field": "goal.followupChannel",
      "label": "希望怎么跟进？",
      "level": "LATER"
    },
    {
      "field": "goal.followupFrequency",
      "label": "希望多久沟通一次？",
      "level": "LATER"
    },
    {
      "field": "goal.constraints",
      "label": "经济或时间上有什么限制？",
      "level": "LATER"
    }
  ]
}
