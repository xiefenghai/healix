{
  "code": "HTN_CLINICAL",
  "version": 2,
  "title": "高血压管理",
  "script": "再确认一下血压这块：平时控得怎么样、自测习惯和吃药规律。定控压目标和运动、限盐时会参考。",
  "items": [
    {
      "field": "disease.hypertension.diagnosedYear",
      "label": "大概哪一年得知患高血压？（选年份）",
      "level": "FIRST_VISIT",
      "sensitive": true
    },
    {
      "field": "disease.hypertension.homeMonitor",
      "label": "在家有测血压吗？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "disease.hypertension.latestSystolic",
      "label": "近期收缩压大概多少？",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "op": ">=", "value": 160 },
          "severity": "CAUTION",
          "planEffect": "血压偏高时力量训练与高强度运动需谨慎，优先稳压"
        }
      ]
    },
    {
      "field": "disease.hypertension.latestDiastolic",
      "label": "近期舒张压大概多少？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "disease.hypertension.morningPeak",
      "label": "有没有晨起血压明显偏高？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "disease.hypertension.orthostatic",
      "label": "起立后有没有头晕或眼前发黑？",
      "level": "FIRST_VISIT",
      "sensitive": true,
      "highlights": [
        {
          "when": { "eq": "YES" },
          "severity": "CAUTION",
          "planEffect": "注意直立性低血压；起身宜慢，运动前后勿突然起立"
        }
      ]
    },
    {
      "field": "disease.hypertension.medAdherence",
      "label": "降压药吃得规律吗？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "basic.medicationFlags",
        "intersects": ["ANTIHYPERTENSIVE"]
      },
      "sensitive": true,
      "highlights": [
        {
          "when": { "in": ["IRREGULAR", "STOPPED"] },
          "severity": "CAUTION",
          "planEffect": "先提醒按时用药，再谈限盐与运动"
        }
      ]
    },
    {
      "field": "disease.hypertension.highestSystolic",
      "label": "以前测到过的最高收缩压？",
      "level": "LATER"
    },
    {
      "field": "disease.hypertension.highestDiastolic",
      "label": "以前测到过的最高舒张压？",
      "level": "LATER"
    }
  ]
}
