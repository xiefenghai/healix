{
  "code": "GOALS_PREFERENCE",
  "version": 3,
  "title": "诉求与目标",
  "script": "先了解这次最想改善什么。定好方向后，后面只问相关题，少打扰。",
  "items": [
    {
      "field": "goal.primaryAppeal",
      "label": "这次最想解决什么问题？（可多选）",
      "level": "REQUIRED"
    },
    {
      "field": "goal.careTracks",
      "label": "本次纳入哪些管理方向？",
      "level": "STAFF"
    },
    {
      "field": "goal.appealText",
      "label": "用一句话说说你的期望（选填）",
      "level": "FIRST_VISIT"
    },
    {
      "field": "goal.doctorAdvised",
      "label": "是医生建议做这次管理的吗？",
      "level": "LATER"
    },
    {
      "field": "goal.mode",
      "label": "本次主目标类型",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["WEIGHT_LOSS", "DIABETES", "HYPERTENSION"]
      }
    },
    {
      "field": "goal.targetWeightKg",
      "label": "希望体重到多少？",
      "level": "FIRST_VISIT",
      "showIf": {
        "all": [
          { "field": "goal.careTracks", "intersects": ["WEIGHT_LOSS"] },
          { "field": "goal.mode", "eq": "LOSS" }
        ]
      },
      "highlights": [
        {
          "when": { "computed": "目标BMI", "op": "<", "value": 18.5 },
          "severity": "CAUTION",
          "planEffect": "按当前身高计算，目标体重对应 BMI < 18.5，请先补身高或上调目标体重"
        }
      ]
    },
    {
      "field": "goal.targetDate",
      "label": "希望多久达到体重目标？",
      "level": "FIRST_VISIT",
      "showIf": {
        "all": [
          { "field": "goal.careTracks", "intersects": ["WEIGHT_LOSS"] },
          { "field": "goal.mode", "eq": "LOSS" }
        ]
      }
    },
    {
      "field": "goal.targetWaistCm",
      "label": "腰围目标（健管师选填，可不问客户）",
      "level": "STAFF",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["WEIGHT_LOSS"]
      }
    },
    {
      "field": "goal.targetBodyFat",
      "label": "体脂率目标（健管师选填）",
      "level": "STAFF",
      "showIf": {
        "all": [
          { "field": "goal.careTracks", "intersects": ["WEIGHT_LOSS"] },
          { "field": "goal.mode", "eq": "BODY_COMPOSITION" }
        ]
      }
    },
    {
      "field": "goal.targetHba1c",
      "label": "糖化血红蛋白目标（%）（健管师按指南选填）",
      "level": "STAFF",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["DIABETES"]
      }
    },
    {
      "field": "goal.targetFpg",
      "label": "空腹血糖目标（mmol/L）（健管师选填）",
      "level": "STAFF",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["DIABETES"]
      }
    },
    {
      "field": "goal.targetBpSys",
      "label": "收缩压目标（高压）（健管师选填）",
      "level": "STAFF",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["HYPERTENSION"]
      }
    },
    {
      "field": "goal.targetBpDia",
      "label": "舒张压目标（低压）（健管师选填）",
      "level": "STAFF",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["HYPERTENSION"]
      }
    },
    {
      "field": "goal.exerciseMinutesPerDay",
      "label": "每天大概能拿出多少时间活动或运动？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["WEIGHT_LOSS", "DIABETES", "HYPERTENSION"]
      }
    },
    {
      "field": "goal.dietEffort",
      "label": "饮食上能做多大调整？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["WEIGHT_LOSS", "DIABETES", "HYPERTENSION"]
      }
    },
    {
      "field": "goal.followupChannel",
      "label": "希望怎么跟进？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "goal.followupFrequency",
      "label": "希望多久沟通一次？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "goal.constraints",
      "label": "目前最大的阻力或限制是什么？（经济、时间、家人等）",
      "level": "FIRST_VISIT"
    }
  ]
}
