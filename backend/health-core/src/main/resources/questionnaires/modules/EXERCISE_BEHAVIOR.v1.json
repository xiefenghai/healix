{
  "code": "EXERCISE_BEHAVIOR",
  "version": 1,
  "title": "运动行为",
  "script": "平时有运动习惯吗？哪个时间段对您比较方便？我们尽量按您的节奏来安排，不强求一下子做很多。",
  "items": [
    {
      "field": "basic.exercise.frequency",
      "label": "平时运动（每次 30 分钟以上）的频率？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.exercise.type",
      "label": "一般做什么运动？",
      "level": "LATER",
      "showIf": {
        "field": "basic.exercise.frequency",
        "notIn": [
          "NONE",
          "RARELY"
        ]
      }
    },
    {
      "field": "basic.exercise.intensity",
      "label": "运动强度",
      "level": "LATER",
      "showIf": {
        "field": "basic.exercise.frequency",
        "notIn": [
          "NONE",
          "RARELY"
        ]
      }
    },
    {
      "field": "basic.exercise.durationMin",
      "label": "每次运动多长时间？",
      "level": "LATER",
      "showIf": {
        "field": "basic.exercise.frequency",
        "notIn": [
          "NONE",
          "RARELY"
        ]
      }
    },
    {
      "field": "basic.exercise.strengthExperience",
      "label": "做过力量训练吗？",
      "level": "LATER"
    },
    {
      "field": "basic.exercise.dailySteps",
      "label": "平时一天大概走多少步？",
      "level": "LATER"
    },
    {
      "field": "basic.exercise.sedentaryHours",
      "label": "一天大概坐多久？",
      "level": "LATER"
    },
    {
      "field": "basic.exercise.availableSlots",
      "label": "一般什么时候有空运动？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.exercise.venue",
      "label": "在哪运动方便？",
      "level": "LATER"
    },
    {
      "field": "basic.exercise.equipment",
      "label": "家里有什么器械？",
      "level": "LATER",
      "showIf": {
        "field": "basic.exercise.venue",
        "intersects": [
          "HOME"
        ]
      }
    },
    {
      "field": "basic.exercise.note",
      "label": "运动备注",
      "level": "LATER"
    }
  ]
