{
  "code": "DIET_BEHAVIOR",
  "version": 2,
  "title": "饮食行为",
  "script": "想了解一下平时一天大概怎么吃。按真实情况说就好，没有对错，这样定出来的建议才好坚持。",
  "items": [
    {
      "field": "basic.diet.mealRegularity",
      "label": "一日三餐规律吗？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.diet.dinnerTime",
      "label": "晚餐通常几点吃？",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "in": ["AFTER_21"] },
          "severity": "CAUTION",
          "planEffect": "晚餐偏晚，不安排刚吃完就运动；可改成睡前轻度拉伸"
        }
      ]
    },
    {
      "field": "basic.diet.breakfast",
      "label": "早餐吃吗？",
      "level": "LATER"
    },
    {
      "field": "basic.diet.takeoutFrequency",
      "label": "点外卖或在外面吃的频率？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.diet.snackNight",
      "label": "吃零食或夜宵的频率？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.diet.sugaryDrinks",
      "label": "奶茶、可乐、果汁这类含糖饮料喝多少？",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "in": ["DAILY_1", "DAILY_2PLUS"] },
          "severity": "CAUTION",
          "planEffect": "控糖 / 减重方案优先减含糖饮料"
        }
      ]
    },
    {
      "field": "basic.diet.taste",
      "label": "您的日常饮食更接近哪种？（可多选）",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "intersects": ["SALTY"] },
          "severity": "CAUTION",
          "planEffect": "口味偏咸：高血压重点限盐，减重也少吃腌制食品"
        },
        {
          "when": { "intersects": ["OILY"] },
          "severity": "CAUTION",
          "planEffect": "偏油或爱吃油炸：给清淡少油、少炸的替换"
        },
        {
          "when": { "intersects": ["REFINED"] },
          "severity": "CAUTION",
          "planEffect": "主食以精米白面为主：控糖方案里逐步换成粗细搭配"
        },
        {
          "when": { "intersects": ["SWEET"] },
          "severity": "CAUTION",
          "planEffect": "常吃甜食或含糖饮料：控糖和减重优先减这一项"
        }
      ]
    },
    {
      "field": "basic.diet.staple",
      "label": "主食一般吃什么？（面诊可再细问）",
      "level": "STAFF"
    },
    {
      "field": "basic.diet.vegFruit",
      "label": "蔬菜水果吃得多吗？",
      "level": "LATER"
    },
    {
      "field": "basic.diet.cooking",
      "label": "家里做菜常用哪些方式？（面诊可再细问）",
      "level": "STAFF",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": ["HYPERTENSION", "WEIGHT_LOSS", "DIABETES"]
      }
    },
    {
      "field": "basic.diet.eatingSpeed",
      "label": "吃一顿饭大概多久？",
      "level": "LATER"
    },
    {
      "field": "basic.diet.waterMl",
      "label": "每天大概喝多少水？",
      "level": "LATER"
    },
    {
      "field": "basic.diet.cook",
      "label": "平时主要谁做饭？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.diet.livingAlone",
      "label": "是一个人住吗？",
      "level": "LATER"
    },
    {
      "field": "basic.diet.trackedBefore",
      "label": "以前记录过饮食吗？",
      "level": "LATER"
    },
    {
      "field": "basic.diet.note",
      "label": "饮食备注",
      "level": "LATER"
    }
  ]
}
