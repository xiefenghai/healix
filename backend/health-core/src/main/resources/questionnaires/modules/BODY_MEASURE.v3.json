{
  "code": "BODY_MEASURE",
  "version": 3,
  "title": "体测",
  "script": "先记身高体重；有腰围/血压更好。测量来源不再单问，默认按现场或客户自述入库。",
  "items": [
    {
      "field": "metric.HEIGHT",
      "label": "身高",
      "level": "REQUIRED"
    },
    {
      "field": "metric.WEIGHT",
      "label": "体重",
      "level": "REQUIRED",
      "highlights": [
        {
          "when": {
            "computed": "BMI",
            "op": "<",
            "value": 18.5
          },
          "severity": "REFER",
          "planEffect": "偏瘦：不设减重目标，优先营养与转介评估"
        }
      ]
    },
    {
      "field": "metric.WAIST",
      "label": "腰围（肚脐上方一横指水平绕一圈）",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": [
          "WEIGHT_LOSS",
          "DIABETES"
        ]
      }
    },
    {
      "field": "metric.BODY_FAT",
      "label": "体脂率（体脂秤或体成分仪）",
      "level": "LATER",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": [
          "WEIGHT_LOSS"
        ]
      }
    },
    {
      "field": "metric.BLOOD_PRESSURE_SYS",
      "label": "血压：高压（收缩压）",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": [
          "HYPERTENSION",
          "DIABETES",
          "WEIGHT_LOSS"
        ]
      },
      "highlights": [
        {
          "when": {
            "op": "≥",
            "value": 180.0
          },
          "severity": "REFER",
          "planEffect": "血压很高，建议先就医，暂缓中高强度运动"
        }
      ]
    },
    {
      "field": "metric.BLOOD_PRESSURE_DIA",
      "label": "血压：低压（舒张压）",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "goal.careTracks",
        "intersects": [
          "HYPERTENSION",
          "DIABETES",
          "WEIGHT_LOSS"
        ]
      },
      "highlights": [
        {
          "when": {
            "op": "≥",
            "value": 110.0
          },
          "severity": "REFER",
          "planEffect": "同上"
        }
      ]
    },
    {
      "field": "metric.HEART_RATE",
      "label": "静息心率",
      "level": "LATER",
      "highlights": [
        {
          "when": {
            "op": "<",
            "value": 50.0
          },
          "severity": "CAUTION",
          "planEffect": "运动前建议先就医评估"
        }
      ]
    }
  ]
}
