{
  "code": "SLEEP_SUBSTANCE",
  "version": 2,
  "title": "睡眠与烟酒",
  "script": "睡眠和作息对血压、血糖、力气和食欲影响都挺大。想简单了解平时几点睡、睡得怎么样，以及烟酒情况。",
  "items": [
    {
      "field": "profile.workSchedule",
      "label": "平时作息是哪种？",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "in": ["SHIFT", "NIGHT"] },
          "severity": "CAUTION",
          "planEffect": "餐次、用药提醒与运动时段按班次安排"
        }
      ]
    },
    {
      "field": "basic.schedule.offWork",
      "label": "平时大概几点下班？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "profile.workSchedule",
        "in": ["DAY", "IRREGULAR"]
      },
      "highlights": [
        {
          "when": { "in": ["H20_21", "AFTER_21"] },
          "severity": "CAUTION",
          "planEffect": "下班晚，不要安排晚饭前运动，改为睡前轻度拉伸"
        }
      ]
    },
    {
      "field": "basic.schedule.offWorkNote",
      "label": "倒班或夜班时，大概哪些时段在上班？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "profile.workSchedule",
        "in": ["SHIFT", "NIGHT"]
      }
    },
    {
      "field": "basic.lifestyle.activityLevel",
      "label": "工作和日常活动量属于哪种？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.sleep.hours",
      "label": "每天大概睡几个小时？",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "op": "<", "value": 6.0 },
          "severity": "CAUTION",
          "planEffect": "睡眠不足影响食欲、血压与控糖，方案可加入睡眠改善"
        }
      ]
    },
    {
      "field": "basic.sleep.refreshed",
      "label": "早上起来觉得解乏吗？",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "eq": "NO" },
          "severity": "CAUTION",
          "planEffect": "醒后仍很累：方案提示睡眠呼吸监测，肥胖或高血压时优先"
        }
      ]
    },
    {
      "field": "basic.sleep.bedTime",
      "label": "一般几点睡？",
      "level": "LATER"
    },
    {
      "field": "basic.sleep.wakeTime",
      "label": "一般几点起？",
      "level": "LATER"
    },
    {
      "field": "basic.sleep.quality",
      "label": "睡眠质量",
      "level": "LATER"
    },
    {
      "field": "basic.sleep.disorder",
      "label": "睡眠问题",
      "level": "LATER"
    },
    {
      "field": "basic.sleep.lateNight",
      "label": "多久熬一次夜（凌晨以后睡）？",
      "level": "LATER"
    },
    {
      "field": "basic.sleep.note",
      "label": "睡眠备注",
      "level": "LATER"
    },
    {
      "field": "basic.lifestyle.smoking.status",
      "label": "吸烟吗？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.lifestyle.smoking.cigarettesPerDay",
      "label": "每天几支？",
      "level": "LATER",
      "showIf": {
        "field": "basic.lifestyle.smoking.status",
        "in": ["CURRENT", "OCCASIONAL"]
      }
    },
    {
      "field": "basic.lifestyle.smoking.years",
      "label": "吸了多少年？",
      "level": "LATER",
      "showIf": {
        "field": "basic.lifestyle.smoking.status",
        "in": ["CURRENT", "OCCASIONAL", "QUIT"]
      }
    },
    {
      "field": "basic.lifestyle.smoking.quitYear",
      "label": "哪年戒的？",
      "level": "LATER",
      "showIf": {
        "field": "basic.lifestyle.smoking.status",
        "eq": "QUIT"
      }
    },
    {
      "field": "basic.lifestyle.smoking.passive",
      "label": "家里或单位经常有人在身边吸烟吗？",
      "level": "LATER",
      "showIf": {
        "field": "basic.lifestyle.smoking.status",
        "in": ["NEVER", "QUIT"]
      }
    },
    {
      "field": "basic.lifestyle.drinking.status",
      "label": "喝酒吗？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.lifestyle.drinking.frequency",
      "label": "多久喝一次？",
      "level": "LATER",
      "showIf": {
        "field": "basic.lifestyle.drinking.status",
        "in": ["CURRENT", "OCCASIONAL"]
      }
    },
    {
      "field": "basic.lifestyle.drinking.type",
      "label": "常喝什么酒？",
      "level": "LATER",
      "showIf": {
        "field": "basic.lifestyle.drinking.status",
        "in": ["CURRENT", "OCCASIONAL"]
      }
    },
    {
      "field": "basic.lifestyle.drinking.amountPerDay",
      "label": "一次喝多少？",
      "level": "LATER",
      "showIf": {
        "field": "basic.lifestyle.drinking.status",
        "in": ["CURRENT", "OCCASIONAL"]
      }
    }
  ]
}
