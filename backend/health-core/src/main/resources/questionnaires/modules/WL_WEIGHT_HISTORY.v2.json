{
  "code": "WL_WEIGHT_HISTORY",
  "version": 2,
  "title": "减重史",
  "script": "以前尝试过减重吗？您走过的路对我们很有用，能帮后面少走弯路，避开不太适合您的做法。",
  "items": [
    {
      "field": "basic.weightHistory.triedBefore",
      "label": "以前减过重吗？",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "eq": "MULTIPLE" },
          "severity": "CAUTION",
          "planEffect": "体重反复的客户节奏更保守，重点防反弹"
        }
      ]
    },
    {
      "field": "basic.weightHistory.methods",
      "label": "以前用过哪些方法？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "basic.weightHistory.triedBefore",
        "notIn": ["NEVER", "NONE"]
      },
      "highlights": [
        {
          "when": { "eq": "SURGERY" },
          "severity": "CAUTION",
          "planEffect": "术后营养需求特殊，需了解术式与时间"
        }
      ]
    },
    {
      "field": "basic.weightHistory.maxLossKg",
      "label": "最多一次减了多少公斤？",
      "level": "LATER",
      "showIf": {
        "field": "basic.weightHistory.triedBefore",
        "notIn": ["NEVER", "NONE"]
      }
    },
    {
      "field": "basic.weightHistory.failReasons",
      "label": "之前没坚持下来或反弹的主要原因？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "basic.weightHistory.triedBefore",
        "notIn": ["NEVER", "NONE"]
      }
    },
    {
      "field": "basic.weightHistory.maxWeightKg",
      "label": "成年后最重大概多少公斤？",
      "level": "LATER"
    },
    {
      "field": "basic.weightHistory.minAdultWeightKg",
      "label": "成年后最轻大概多少公斤？",
      "level": "LATER"
    },
    {
      "field": "basic.weightHistory.recentTrend",
      "label": "最近 3–6 个月体重有变化吗？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "basic.weightHistory.recentChangeKg",
      "label": "大概变了多少公斤？",
      "level": "LATER",
      "showIf": {
        "field": "basic.weightHistory.recentTrend",
        "notIn": ["STABLE"]
      }
    }
  ]
}
