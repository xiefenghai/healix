{
  "code": "DM_CLINICAL",
  "version": 2,
  "title": "糖尿病管理",
  "script": "接下来专门了解血糖相关情况：分型、监测、近期指标和用药规律，方便定控糖节奏，也注意防低血糖。",
  "items": [
    {
      "field": "disease.diabetes.type",
      "label": "糖尿病是哪一型？",
      "level": "FIRST_VISIT",
      "sensitive": true
    },
    {
      "field": "disease.diabetes.diagnosedYear",
      "label": "大概哪一年确诊的？（选年份）",
      "level": "FIRST_VISIT",
      "sensitive": true
    },
    {
      "field": "disease.diabetes.chronicComplications",
      "label": "有没有医生说过的慢性并发症？",
      "level": "FIRST_VISIT",
      "sensitive": true
    },
    {
      "field": "disease.diabetes.hypoglycemia",
      "label": "有没有出现过低血糖？",
      "level": "FIRST_VISIT",
      "sensitive": true,
      "highlights": [
        {
          "when": { "eq": "SEVERE" },
          "severity": "CAUTION",
          "planEffect": "热量缺口与运动前注意防低血糖，调整前与医生沟通"
        }
      ]
    },
    {
      "field": "disease.diabetes.monitorFreq",
      "label": "平时测血糖频次？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "disease.diabetes.latestHba1c",
      "label": "最近一次糖化血红蛋白？",
      "level": "FIRST_VISIT",
      "highlights": [
        {
          "when": { "op": ">=", "value": 8 },
          "severity": "CAUTION",
          "planEffect": "控糖优先；若同时减重，节奏宜稳，避免激进缺口"
        }
      ]
    },
    {
      "field": "disease.diabetes.latestFpg",
      "label": "最近空腹血糖？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "disease.diabetes.latestPpg",
      "label": "最近餐后 2 小时血糖？",
      "level": "FIRST_VISIT"
    },
    {
      "field": "disease.diabetes.medAdherence",
      "label": "降糖药 / 胰岛素吃得规律吗？",
      "level": "FIRST_VISIT",
      "showIf": {
        "field": "basic.medicationFlags",
        "intersects": ["HYPOGLYCEMIC"]
      },
      "sensitive": true,
      "highlights": [
        {
          "when": { "in": ["IRREGULAR", "STOPPED"] },
          "severity": "CAUTION",
          "planEffect": "先提醒按医嘱用药，方案不强推大幅饮食变动"
        }
      ]
    },
    {
      "field": "disease.diabetes.eyeCheck",
      "label": "最近一次眼底检查大概什么时候？",
      "level": "LATER"
    }
  ]
}
